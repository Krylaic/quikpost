{% extends '/layouts/base.twig' %}

{% block content %}
<div class="row">
    <div class="span5">
    <form action="/register" method="POST" class="form-stacked" id="registerForm">
        <fieldset>
            <h2>Sign Up for {{ site_name }}</h2>
            <div class="clearfix" id="usernameField">
                <label for="username">Username</label>
                <div class="input">
                        <div class="input-prepend">
                            <span class="add-on">@</span>
                            <input style="width:243px;" placeholder="Username" class="xlarge" id="username" name="username" size="30" type="text">
                        </div>
                    </div>
            </div>
            <div class="clearfix" id="emailField">
                <label for="email">E-mail</label>
                <div class="input">
                    <input placeholder="email@example.com" class="xlarge" id="email" name="email" size="30" type="email">
                </div>
            </div>
            <div class="clearfix" id="password1Field">
                <label for="password1">Password</label>
                <div class="input">
                    <input placeholder="Password" class="xlarge" id="password1" name="password1" size="30" type="password">
                </div>
            </div>
            <div class="clearfix" id="password2Field">
                <label for="password2">Confirm Password</label>
                <div class="input">
                    <input placeholder="Confirm Password" class="xlarge" id="password2" name="password2" size="30" type="password">
                </div>
            </div>
            <div class="clearfix" id="captcha">
                <label for="captcha">CAPTCHA</label>
                <div class="input">
                    <div><div style="width: 150px; height: 50px;"><div><img src="/captcha" alt="CAPTCHA Image" /></div></div>
                </div>
                <div class="input">
                    <input id="captcha" name="captcha" type="text" placeholder="Enter code...">
                </div>
            </div>
            <div id="tosField">
                <label>
                    <input type="checkbox" name="tos" id="tos">
                    <span>I agree to the <a href="/tos">Terms of Service</a> &amp; <a href="/privacy">Privacy Policy</a>!</span>
                </label>
            </div>
            <span class="help-block">
                Already have an account? <a href="/login">Click here</a> to sign in!
            </span>
        </fieldset>
        <button type="submit" class="btn btn-primary" id="registerBtn">Register</button>
    </form>
    


    </div>
    <div class="span3 ">
        <h3>{{ site_name }} Information</h3>
        <ul>
        <li>Please be over the age of 13!</li>
        <li>Read the <a href="/tos">Terms of Service</a>!</li>
        <li>Follow <a href="/community_guidelines">community guidelines</a>!</li>
        <ul>
    </ul></ul></div>
</div>

<hr>
{% endblock %}