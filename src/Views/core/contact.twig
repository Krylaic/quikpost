{% extends '/layouts/base.twig' %}

{% block content %}
<form action="/contact" method="POST" class="form-stacked">
    <fieldset>
        <h2>Contact {{site_name}}</h2>
        
        <div class="clearfix">
            <label for="reason">Reason for contacting us</label>
            <div class="input">
                <textarea placeholder="I am contacting you because..." class="xlarge" name="content" size="30"></textarea>
            </div>
        </div>
        <div class="clearfix">
            <label for="reason">Email address</label>
            <div class="input">
                <input placeholder="me@example.com" class="xlarge" name="email" size="30" type="email">
            </div>
        </div>
        <div class="clearfix" id="captcha">
            <label for="captcha">CAPTCHA</label>
            <div class="input">
                <div><div style="width: 150px; height: 50px;"><div><img src="/captcha" alt="CAPTCHA Image" /></div></div>
            </div>
            <div class="input">
                <input id="captcha" name="captcha" type="text" placeholder="Enter code...">
            </div>
        </div>
    </fieldset>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
<hr>
{% endblock %}