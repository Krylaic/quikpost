{% extends '/layouts/base.twig' %}

{% block content %}
<h1>Themes</h1>
<a href="/themes/create" class="btn btn-primary">Make a theme</a><br><br>
{% if current_user.active_theme %}
<form method="POST" action="/themes/remove">
<input type="hidden" name="csrf" value="{{ csrf }}">
<button type="submit" class="btn btn-warning">Uninstall Current Theme</button>
</form>
{%endif %}

{# i asked gemini how 2 do this and it just put me onto the batch method this is kinda tuff #}
{% for row in themes|batch(3) %}
    <div class="row-fluid">
        <ul class="thumbnails">
            {% for theme in row %}
                <li class="span4">
                    <div class="thumbnail">
                        <img src="{{ theme.image }}" width="300" height="200">
                        <div class="caption">
                            <h3>{{ theme.title }}</h3>
                            <p>{{ theme.description }}</p>
                            <p><a href="/themes/{{theme.id}}" class="btn btn-primary">Install Theme</a></p>
                            <p>Installed {{ theme.installs }} times</p>
                            <p>Made by: {{theme.username  }}</p>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endfor %}

{%if themes|length == 0 %}
<p>No themes are here yet!</p>
{%endif %}

<ul class="pager">
  {% if page > 1 %}
    <li class="previous"><a href="/themes/page/{{ page - 1 }}">&larr; Newer</a></li>
  {% endif %}
  {% if themes|length == 15 %}
    <li class="next"><a href="/themes/page/{{ page + 1 }}">Older &rarr;</a></li>
  {% endif %}
</ul>
<hr>
{% endblock %}