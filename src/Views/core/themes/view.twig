{% extends '/layouts/base.twig' %}

{% block content %}



                    <div class="thumbnail">
                        <img src="{{ theme.image }}" >
                        <div class="caption">
                            <h3>{{ theme.title }}</h3>
                            <p>{{ theme.description }}</p>

                            {% if current_user %}
                            {% if current_user.active_theme == theme.id %}
                                <form method="POST" action="/themes/remove">
                                <input type="hidden" name="csrf" value="{{ csrf }}">
                                <button type="submit" class="btn btn-warning">Uninstall Theme</button>
                                </form>
                            {% else %}
                                <form method="POST" action="/themes/apply/{{ theme.id }}">
                                <input type="hidden" name="csrf" value="{{ csrf }}">
                                <button type="submit" class="btn btn-primary">Install Theme</button>
                                </form>
                            {% endif %}

                            {% if current_user.id == theme.author or current_user.admin_level > 0 %}
                            <hr>
                            <a href="/themes/edit/{{ theme.id }}" class="btn">Edit Theme</a>
                            <form method="POST" action="/themes/delete/{{ theme.id }}" style="margin-top:8px;">
                                <input type="hidden" name="csrf" value="{{ csrf }}">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this theme?');">Delete Theme</button>
                            </form>
                            {% endif %}
                            {%endif %}
                            
                            <p>Installed {{ theme.installs }} times</p>
                            <p>Published: {{ theme.creation_date|date('M jS, Y g:iA') }}</p>
                            <p>Last Updated: {{ theme.updated_date ? theme.updated_date|date('M jS, Y g:iA') : "Never updated" }}</p>
                        </div>
<hr>
                        <div class="caption">
                            <p>CSS:</p>
                            <code>{{theme.css|nl2br }}</code>
                        </div>
                    </div>





<hr>
{% endblock %}