{% extends '/layouts/base.twig' %}

{% block content %}
<form action="/report" method="POST" class="form-stacked">
    <fieldset>
        <h2>Report a post</h2>
        <p>You are reporting <a href="/status/{{post.id}}">this</a> post.</p><br>
        
        <div class="clearfix">
            <label for="reason">Reason for reporting</label>
            <div class="input">
                <textarea placeholder="I am reporting this post because..." class="xlarge" name="reason" size="30"></textarea>
            </div>
        </div>
        <div class="clearfix" id="captcha">
            <label for="captcha">CAPTCHA</label>
            <div class="input">
                <div><div style="width: 150px; height: 50px;"><div><img src="/captcha" alt="CAPTCHA Image" /></div></div>
            </div>
            <div class="input">
                <input id="captcha" name="captcha" type="text" placeholder="Enter code...">
            </div>
        </div>
    </fieldset>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
<hr>
{% endblock %}