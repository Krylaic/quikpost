<style>
.user-grid {
    overflow: hidden;
    margin-right: -6px;
}

.user-avatar {
    display: block;
    float: left;
    width: 35px;
    height: 35px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.user-avatar img {
    display: block;
}

.user-avatar:hover img {
    border-color: #999;
}
</style>

<script>
