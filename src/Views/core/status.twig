{% extends '/core/feeds/base.twig' %}


{% block dashboardmain %}



<div class="posts">

      <div class="post" style="border-bottom: 1px solid #eee;">
        {% if post.reply_to %}
        <div style="margin-left:40px;margin-top:-8px;margin-bottom:2px;">
            <img class="pull-left" src="/assets/img/arrow_redo.png">
            <span style="color:#444;margin-left:3px;margin-top:-2px;font-size:13px;">Replying to <i><a href="/status/{{ post.reply_to }}">"{{ post.reply_to_content }}"</a></i></span>
        </div>
        {% endif %}
        <div class="post-content">
          <div class="post-avatar-wrap">
            <img src="{{ post.author_avatar }}" width="40" height="40" class="post-avatar">
          </div>

          <div class="post-right">
            <div class="post-user"><a href="/user/{{ post.author_name }}">{{ post.author_display_name ?? post.author_name }}</a> <span>{{ post.post_date|timeAgo }}</span></div>
            <p class="post-text">{{ post.content }}</p>
          {% if post.attachment %}
          <img class="post-img" src="{{ post.attachment }}">
          {% endif %}
            <div class="post-actions">
              <div class="pull-left">
                <a class="like" href="/like/{{ post.id }}">
                  <div class="like-icon"></div>
                  <div class="like-text">0</div>
                </a>
                <a class="reply" href="/status/{{ post.id }}">
                  <div class="reply-icon"></div>
                  <div class="reply-text">{{ post.reply_count }} {% if post.reply_count == 1 %}reply{% else %}replies{% endif %}</div>
                </a>
              </div>
              <div class="pull-right">
                <a class="report" href="/report/{{post.id }}">
                  <div class="report-text">Report</div>
                  <div class="report-icon"></div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

{% if current_user %}
    <div class="post-box">
      <form method="POST" action="/post" enctype="multipart/form-data">
        
        <div>
          <img src="{{ current_user.avatar }}" width="48" height="48" class="pull-left" style="border:1px solid #cccccc;border-radius:4px;">
          <textarea name="content" class="pull-left" placeholder="Reply with something cool..." maxlength="255"></textarea>
        </div>
        <input type="hidden" name="reply_to" value="{{ post.id }}">
        <div class="post-box-actions">
          <div class="actions">
            <label for="file-input" style="cursor: pointer;" class="pull-left">
                <img src="/assets/ico/picture_add.png" alt="Add Picture">
            </label>
            <input type="file" id="file-input" style="display: none;" accept="image/*" name="attachment">
        </div>
        
        <!-- i got gemini to make this for me pls dont judge i hate javacsirpt-->
      <script>
          const fileInput = document.getElementById('file-input');

          fileInput.addEventListener('change', (event) => {
              const file = event.target.files[0];
              if (file) {
                  alert(`File successfully selected, it will be attached in your post`);
              }
          });
      </script>
          <input type="submit" class="btn btn-primary" value="Post">
        </div>
      </form>
    </div>

    {% endif %}

    {% if replies is not empty %}
    {% for post in replies %}
      <div class="post">
        <div class="post-content">
          <div class="post-avatar-wrap">
            <img src="{{ post.author_avatar }}" width="40" height="40" class="post-avatar">
          </div>

          <div class="post-right">
            <div class="post-user"><a href="/user/{{ post.author_name }}">{{ post.author_display_name ?? post.author_name }}</a> <span>{{ post.post_date|timeAgo }}</span></div>
            <p class="post-text">{{ post.content }}</p>
          {% if post.attachment %}
          <img class="post-img" src="{{ post.attachment }}">
          {% endif %}
            <div class="post-actions">
              <div class="pull-left">
                <a class="like" href="/like/{{ post.id }}">
                  <div class="like-icon"></div>
                  <div class="like-text">0</div>
                </a>
                <a class="reply" href="/status/{{ post.id }}">
                  <div class="reply-icon"></div>
                  <div class="reply-text">{{ post.reply_count }} {% if post.reply_count == 1 %}reply{% else %}replies{% endif %}</div>
                </a>
              </div>
              <div class="pull-right">
                <a class="report" href="/report/{{post.id }}">
                  <div class="report-text">Report</div>
                  <div class="report-icon"></div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
{% else %}
    <div id="error" style="position: relative; width: 100%; min-height: 150px; margin-top: 20px; padding: 0 0 12px; text-align: center; font-size: 0;">
        <span style="display: inline-block; height: 100%; vertical-align: middle;"></span>
        <div style="position: relative; display: inline-block; vertical-align: middle; text-align: left; max-width: 320px; width: 100%; font-size: 13px;">
            <h1 style="font-size: 20px; font-weight: 500; margin-top: 0; margin-bottom: 0;">Uh oh!</h1>
            <p style="position: relative; margin-top: 0; font-size: 13px; cursor: default; color: gray; font-weight: 400;">
                There aren't any replies yet! Why not make one?
            </p>
        </div>
    </div>
{% endif %}

</div>

{% endblock %}