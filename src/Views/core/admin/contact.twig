{% extends '/core/admin/base.twig' %} 

{% block tool %}
<table class="table table-striped table-bordered" cellspacing="0" cellpadding="5">
    <h3>Contact</h3>
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Message</th>
            <th>Date</th>
        </tr>
    </thead>
    {% if messages %}
    <tbody>
        {% for message in messages %}
        <tr>
            <td>{{ message.id }}</td>
            <td>{{ message.email }}</td>
            <td>{{ message.content|nl2br }}</td>
            <td>{{ message.contact_date|date("M j, Y, g:i:sa") }}</td>
        </tr>
        {% endfor %}
    </tbody>
    {% endif %}
</table>

{% if messages %}
<ul class="pager" style="padding: 0px 10px;">
{% if page > 1 %}
<li class="previous">
    <a href="/admin/contact/{{ page - 1 }}">&larr; Newer</a>
</li>
{% endif %}
{% if messages|length == 15 %}
<li class="next">
    <a href="/admin/contact/{{ page + 1 }}">Older &rarr; </a>
</li>
{% endif %}
</ul>
{% endif %}

{% endblock %}