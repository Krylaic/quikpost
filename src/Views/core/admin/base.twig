{% extends '/layouts/base.twig' %}

{%block content %}

<link href="/assets/css/custom.css" rel="stylesheet">

<div class="profile-header">
  <div class="profile-header-inner" >
    <div style="color:white;margin-left:0 !important;" style="margin-left:0 !important;">
      <h1 style="margin-top:0;text-shadow:0 1px 2px rgba(0,0,0,.5);min-width:230px;font-size:54px;">
          {{tool_title}}
      </h1>
      <h3 style="margin:0;padding:0;line-height:22px;text-shadow:0 1px 2px rgba(0,0,0,.5);font-size:20px;font-weight:300;">
        {{tool_desc}}
      </h3>
    </div>
  </div>
</div>
<div class="dashboard-row clearfix" style="border-left: 1px solid #eee;padding:15px;">
<ul class="nav nav-tabs">
  <li {%if tool_name == "statistics"%} class="active" {%endif%}>
    <a href="/admin">Statistics</a>
  </li>
  <li {%if tool_name == "reports"%} class="active" {%endif%}>
    <a href="/admin/reports">Reports</a>
  </li>
  <li {%if tool_name == "users"%} class="active" {%endif%}>
    <a href="/admin/users">Users</a>
  </li>
  <li {%if tool_name == "news"%} class="active" {%endif%}>
    <a href="/admin/news">News</a>
  </li>
  <li {%if tool_name == "site"%} class="active" {%endif%}>
    <a href="/admin/site">Site Configuration</a>
  </li>
</ul>
{% block tool %}

{% endblock %}
  
</div>


  
<br>

{%endblock%}
