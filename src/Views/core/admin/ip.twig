{% extends '/core/admin/base.twig' %} 

{% block tool %}

<table class="table table-striped table-bordered" cellspacing="0" cellpadding="5" style="max-width: 600px;">
    <h3>IP Addresses for {{ user.username }}</h3>
    <thead>
        <tr>
            <th>IP Address</th>
            <th>Location</th>
            <th>ISP</th>
            <th>VPN</th>
        </tr>
    </thead>
    {% if ips %}
    <tbody>
        {% for ip in ips %}
        <tr>
            <td>{{ ip.address }}</td>
            <td>{{ ip.location }}</td>
            <td>{{ ip.isp }}</td>
            <td>
                {% if ip.is_vpn %}
                    Yes
                {% else %}
                    No
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
    {% else %}
    <p>No IPs found for this user (???)</p>
    {% endif %}
</table>
{% endblock %}