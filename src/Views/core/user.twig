{% extends '/layouts/base.twig' %}

{% block content %}
<link href="/assets/css/custom.css" rel="stylesheet">
<div class="profile-header" style="background:url('{{ user.banner }}') no-repeat center center / cover;">
  <div class="profile-header-inner" style="background:none;">
    <img class="hidden-phone hidden-tablet" src="{{ user.avatar }}" height="77" width="77" style="box-shadow:0 1px 2px rgba(0,0,0,0.25);border-radius:6px;padding-top:1.5px;">
    <div style="color:white;margin-left:0;">
      <h1 style="margin-top:0;text-shadow:0 1px 2px rgba(0,0,0,.5);min-width:230px;font-size:54px;">
          {{ user.display_name ?? user.username }}
      </h1>
      <h3 style="margin:0;padding:0;line-height:22px;text-shadow:0 1px 2px rgba(0,0,0,.5);font-size:20px;font-weight:300;">
        <a href="/user/{{ user.username }}" class="username-link">@{{ user.username }}</a> • member since {{ user.join_date|date("F j, Y") }}
      </h3>
    </div>
  </div>
</div>
<div style="border-top: 1px solid #ccc !important;color:#666 !important;padding:2px;background: linear-gradient(to bottom, #F2F2F2, #ffffff);min-height:24px;font-family: Georgia, 'Helvetica Neue', Helvetica, Arial, sans-serif;border:1px solid #eee;">
  {% if user.location %}
  <span style="line-height:24px;margin-left:5px;" class="pull-left"><i class="icon-globe"></i> {{user.location}}</span>
  {% endif %}
  <span style="line-height:24px;margin-right:5px;" class="pull-right">
    {% if current_user and current_user.username != user.username %}
      <a href="/follow/{{ user.username }}" class="btn btn-mini" style="margin-bottom: 3px;margin-right:6px;">{% if is_following is true %}Unfollow{% else%}Follow{% endif %}</a>
    {% endif %}
    <i class="icon-user"></i>{{ followers[0].total ?? 0 }} follower{% if followers[0].total ?? 0 != 1 %}s{% endif%}
  </span>
</div>
<div class="dashboard-row clearfix">
  <div class="dashboard-main">
    {% if current_user and current_user.username == user.username %}
    <div class="post-box">
      <form method="POST" action="/post" enctype="multipart/form-data">
        <div>
          <img src="{{ current_user.avatar }}" width="48" height="48" class="pull-left" style="border:1px solid #cccccc;border-radius:4px;">
          <textarea name="content" class="pull-left" placeholder="Post to your page..." maxlength="255"></textarea>
        </div>
        <div class="post-box-actions">
          <div class="actions">
            <label for="file-input" style="cursor: pointer;" class="pull-left">
                <img src="/assets/ico/picture_add.png" alt="Add Picture">
            </label>
            <input type="file" id="file-input" style="display: none;" accept="image/*" name="attachment">
          </div>

          <script>
              const fileInput = document.getElementById('file-input');
              fileInput.addEventListener('change', (event) => {
                  const file = event.target.files[0];
                  if (file) {
                      alert(`File successfully selected, it will be attached in your post`);
                  }
              });
          </script>
          <input type="submit" class="btn btn-primary" value="Post">
        </div>
      </form>
    </div>
    {% endif %}
    <div class="posts">
    {% if posts is not empty %}
        {% for post in posts %}
            {% include '/layouts/posts.twig' with { post: post } %}
        {% endfor %}
        <ul class="pager" style="padding:0px 10px;">
          {% if page > 1 %}
          <li class="previous">
            <a href="/user/{{user.username}}/{{ page - 1 }}">&larr; Newer</a>
          </li>
          {% endif %}
          {% if posts|length == 15 %}
          <li class="next">
            <a href="/user/{{user.username}}/{{ page + 1 }}">Older &rarr; </a>
          </li>
          {% endif %}
        </ul>
    {% else %}
        <div id="error" style="position: relative; width: 100%; min-height: 150px; margin-top: 20px; padding: 0 0 12px; text-align: center; font-size: 0;">
            <span style="display: inline-block; height: 100%; vertical-align: middle;"></span>
            <div style="position: relative; display: inline-block; vertical-align: middle; text-align: left; max-width: 320px; width: 100%; font-size: 13px;">
                <h1 style="font-size: 20px; font-weight: 500; margin-top: 0; margin-bottom: 0;">Uh oh!</h1>
                <p style="position: relative; margin-top: 0; font-size: 13px; cursor: default; color: gray; font-weight: 400;">
                    This user hasn't made any posts yet!
                </p>
            </div>
        </div>
    {% endif %}
    </div>
  </div>
  <div class="dashboard-sidebar">
    <div style="word-wrap: break-word; overflow-wrap: break-word; line-height: 1.5; border-bottom: 1px solid #eee; padding: 10px 15px;">
        <div class="mb-2">
            <div style="font-size: 1.0rem; font-weight: 600;">About {{user.username}}</div>
        </div>
        <p class="text-body" style="margin:0;">{{ user.bio ?? 'This user hasn\'t written a biography yet.' }}</p>
    </div>
    <div style="word-wrap: break-word; overflow-wrap: break-word; line-height: 1.5; border-bottom: 1px solid #eee; padding: 10px 15px;">
        <div style="font-size: 1.0rem; font-weight: 600;">Following ({{ following[0].total ?? 0 }})</div>
        {% if following is not empty %}
        <div class="user-grid">
              {% for f_user in following %}
                <a href="/user/{{ f_user.username }}" class="user-avatar" data-toggle="tooltip" data-placement="top" title="{{ f_user.display_name ?? f_user.username }}">
                  <img src="{{ f_user.avatar }}" width="35" height="35" alt="{{ f_user.username }}" style="border:1px solid #cccccc; border-radius:4px;">
                </a>
              {% endfor %}
        </div>
        <span style="text-align:right;"><a href="/following/{{user.username}}">See all following...</a></span>
        {% else %}
        <p class="text-body" style="margin:0;">{{user.username}} isn't following anybody yet!</p>
        {% endif %}
    </div>
    <div style="word-wrap: break-word; overflow-wrap: break-word; line-height: 1.5; border-bottom: 1px solid #eee; padding: 10px 15px;">
        <div style="font-size: 1.0rem; font-weight: 600;">Followers ({{ followers[0].total ?? 0 }})</div>
        {% if followers is not empty %}
        <div class="user-grid">
              {% for f_user in followers %}
                <a href="/user/{{ f_user.username }}" class="user-avatar" data-toggle="tooltip" data-placement="top" title="{{ f_user.display_name ?? f_user.username }}">
                  <img src="{{ f_user.avatar }}" width="35" height="35" alt="{{ f_user.username }}" style="border:1px solid #cccccc; border-radius:4px;">
                </a>
              {% endfor %}
        </div>
        <span style="text-align:right;"><a href="/followers/{{user.username}}">See all followers...</a></span>
        {% else %}
        <p class="text-body" style="margin:0;">Nobody is following {{user.username}} yet!</p>
        {% endif %}
    </div>
    {% if user.lastfm_username and last_song and last_song.recenttracks.track is defined and last_song.recenttracks.track|length > 0 %}
      {% set track = last_song.recenttracks.track[0] %}
      <div style="word-wrap: break-word; overflow-wrap: break-word; line-height: 1.5; border-bottom: 1px solid #eee; padding: 10px 15px;">
          <div style="font-size: 1.0rem; font-weight: 600;">Last Listened To <img src="/assets/img/lastfm.png" width="16"></div>
          <div style="margin-right: -6px;height: 38px;">
              {% if track.image[1]['#text'] %}
                  <img class="pull-left"src="{{ track.image[1]['#text'] }}" width="35" height="35"style="border:1px solid #cccccc; border-radius:4px;">
              {% endif %}
              <div class="pull-left" style="margin-left: 4px;">
                  <strong><p class="text-body" style="margin:0;max-width: 160px;">{{ track.name }}</p></strong>
                  <p class="text-body"style="color: #666;margin:0;margin-top: -4px;">by {{ track.artist['#text'] }}</p>
              </div> 
          </div>
          <span style="text-align:right;"><a href="https://www.last.fm/user/{{user.lastfm_username}}">View more on Last.FM... </a></span>
      </div>
  {% endif %}
  </div>
</div>

<style>
.user-grid {
    overflow: hidden;
    margin-right: -6px;
}
.user-avatar {
    display: block;
    float: left;
    width: 35px;
    height: 35px;
    margin-right: 6px;
    margin-bottom: 6px;
}
.user-avatar img {
    display: block;
}
.user-avatar:hover img {
    border-color: #999;
}
</style>

<script>
    $(function () {$('.user-avatar').tooltip();
    });
</script>
<br>
{% endblock %}