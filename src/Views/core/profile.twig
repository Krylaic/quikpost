{% extends '/layouts/base.twig' %}

{% block content %}
<link href="/assets/css/custom.css" rel="stylesheet">

<div class="profile-header">
  <div class="profile-header-inner" >
    <div style="color:white;margin-left:0 !important;" style="margin-left:0 !important;">
      <h1 style="margin-top:0;text-shadow:0 1px 2px rgba(0,0,0,.5);min-width:230px;font-size:54px;">
          Account Settings
      </h1>
      <h3 style="margin:0;padding:0;line-height:22px;text-shadow:0 1px 2px rgba(0,0,0,.5);font-size:20px;font-weight:300;">
        Customize your profile and update your account
      </h3>
    </div>
  </div>
</div>

<div class="dashboard-row clearfix" style="border-left: 1px solid #eee;padding:15px;">
  
<form style="height:400px;" method="POST" action="/profile" enctype="multipart/form-data">
  <fieldset class="pull-left" style="width:69%;padding-right:5px;height:100%;">
    <legend>Profile Customization</legend>

    <label>Display Name</label>
    <input type="text" placeholder="Write a display name..." value="{{profile.display_name}}" name="display_name">

    <label>Biography</label>
    <textarea placeholder="Write something about yourself..." name="bio">{{profile.bio}}</textarea>

    <label>Location</label>
    <input type="text" placeholder="United States" value="{{profile.location}}" name="location">

    <label style="margin-bottom:0;">Avatar</label>
    <div class="input" style="margin-bottom:5px;">
        <input class="input-file" accept="image/*" name="avatar" type="file">
    </div>

    <label style="margin-bottom:0;">Banner</label>
    <div class="input" style="margin-bottom:5px;">
        <input class="input-file" accept="image/*" name="banner" type="file">
    </div>

  </fieldset>

  <fieldset class="pull-right" style="width:30%;height:100%;">
    <legend>Account</legend>

    <label>Email</label>
    <input type="email" placeholder="email@example.com" value="{{profile.email}}" name="email">
    <span class="help-block">Updating your email requires reverification!</span>

    <label>Last.FM username</label>
    <input type="text" placeholder="My_LastFM_Name" value="{{profile.lastfm_username}}" name="lastfm_username">

  </fieldset>

  <button type="submit" class="btn btn-primary">Update Profile</button>
</form>
  
</div>

<style>
.user-grid {
    overflow: hidden;
    margin-right: -6px;
}

.user-avatar {
    display: block;
    float: left;
    width: 35px;
    height: 35px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.user-avatar img {
    display: block;
}

.user-avatar:hover img {
    border-color: #999;
}
</style>

<script>
    $(function () {
        $('.user-avatar').tooltip();
    });
</script>
  
<br>
{% endblock %}
