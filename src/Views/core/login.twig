{% extends '/layouts/base.twig' %}

{% block content %}
<div class="row">
    <div class="span5">
        <form action="/login" method="POST" class="form-stacked">
            <fieldset>
                <h2>Sign In To {{ site_name }}</h2>
                <div class="clearfix">
                    <label for="xlInput3">Username</label>
                    <div class="input">
                        <div class="input-prepend">
                            <span class="add-on">@</span>
                            <input style="width:243px;" placeholder="Username" class="xlarge" id="xlInput3" name="username" size="30" type="text">
                        </div>
                    </div>
                </div>
                <div class="clearfix">
                    <label for="xlInput3">Password</label>
                    <div class="input">
                        <input placeholder="Password" class="xlarge" id="xlInput3" name="password" size="30" type="password">
                    </div>
                </div>
                <span class="help-block">
                    Need an account? <a href="/register">Click here</a> to sign up!
                </span>
            </fieldset>
            <button type="submit" class="btn btn-primary">Log In</button>
        </form>
    </div>
    <div class="span3">
        <h3>{{ site_name }} Information</h3>
        <ul>
        <li>Please be over the age of 13!</li>
        <li>Read the <a href="/tos">Terms of Service</a>!</li>
        <li>Follow <a href="/community_guidelines">community guidelines</a>!</li>
        <ul>
    </ul></ul></div>
</div>

<hr>
{% endblock %}